import heapq
import sys

class PuzzleNode:
    """Represents a state in the 8-puzzle search tree."""
    def __init__(self, state, parent=None, move="", g=0, h=0):
        self.state = state          # Flat tuple of 9 elements (0 represents the empty space)
        self.parent = parent        # Reference to parent PuzzleNode
        self.move = move            # Move that led to this state ("Up", "Down", "Left", "Right")
        self.g = g                  # Path cost from start to current node
        self.h = h                  # Heuristic cost from current node to goal
        self.f = g + h              # Total estimated cost (f = g + h)

    def __lt__(self, other):
        """Defines comparison for the priority queue based on the f-score."""
        return self.f < other.f

class PuzzleSolver:
    """Solves the 8-puzzle problem using the A* algorithm."""
    def __init__(self, start_state, goal_state):
        self.start_state = tuple(start_state)
        self.goal_state = tuple(goal_state)
        self.moves = {
            "Up": (-1, 0),
            "Down": (1, 0),
            "Left": (0, -1),
            "Right": (0, 1)
        }

    def _manhattan_distance(self, state):
        """Calculates the sum of Manhattan distances of tiles from their goal positions."""
        distance = 0
        for i, value in enumerate(state):
            if value != 0:  # Ignore the blank tile
                current_row, current_col = divmod(i, 3)
                goal_idx = self.goal_state.index(value)
                goal_row, goal_col = divmod(goal_idx, 3)
                distance += abs(current_row - goal_row) + abs(current_col - goal_col)
        return distance

    def _get_neighbors(self, node):
        """Generates valid next states by shifting the empty space (0)."""
        neighbors = []
        state_list = list(node.state)
        blank_idx = state_list.index(0)
        row, col = divmod(blank_idx, 3)

        for move, (dr, dc) in self.moves.items():
            new_row, new_col = row + dr, col + dc
            
            if 0 <= new_row < 3 and 0 <= new_col < 3:
                new_blank_idx = new_row * 3 + new_col
                
                # Swap the blank tile with the target tile
                new_state = state_list[:]
                new_state[blank_idx], new_state[new_blank_idx] = new_state[new_blank_idx], new_state[blank_idx]
                new_state_tuple = tuple(new_state)
                
                h_cost = self._manhattan_distance(new_state_tuple)
                neighbors.append(PuzzleNode(new_state_tuple, node, move, node.g + 1, h_cost))
                
        return neighbors

    def solve(self):
        """Executes the A* search algorithm."""
        open_set = []
        start_h = self._manhattan_distance(self.start_state)
        start_node = PuzzleNode(self.start_state, h=start_h)
        heapq.heappush(open_set, start_node)
        
        closed_set = set()

        while open_set:
            current_node = heapq.heappop(open_set)

            if current_node.state == self.goal_state:
                return self._reconstruct_path(current_node)

            closed_set.add(current_node.state)

            for neighbor in self._get_neighbors(current_node):
                if neighbor.state in closed_set:
                    continue
                
                heapq.heappush(open_set, neighbor)

        return None  

    def _reconstruct_path(self, node):
        """Traces back from the goal node to compile the sequence of configurations and moves."""
        path = []
        current = node
        while current is not None:
            path.append((current.state, current.move))
            current = current.parent
        return path[::-1]  # Return path from start to goal

def print_grid(state):
    """Helper to display the 9-element tuple as a visual 3x3 grid."""
    for i in range(0, 9, 3):
        row = [str(x) if x != 0 else "_" for x in state[i:i+3]]
        print("  " + " ".join(row))
    print()

def get_cli_input(prompt_name):
    """Prompts the user via CLI and ensures a valid 8-puzzle configuration is entered."""
    print(f"\n--- Enter the {prompt_name} State ---")
    print("Provide 9 numbers (0-8) separated by spaces. Use '0' for the blank space.")
    print("Example layout for reference:")
    print("  1 2 3\n  8 0 4\n  7 6 5  --> Type: 1 2 3 8 0 4 7 6 5")
    
    while True:
        try:
            user_input = input(">> ").strip()
            # Parse tokens, converting to integers
            tokens = [int(x) for x in user_input.split()]
            
            if len(tokens) != 9:
                print(f"Error: Expected exactly 9 values, but received {len(tokens)}. Try again.")
                continue
                
            if sorted(tokens) != list(range(9)):
                print("Error: Input must contain all integers from 0 to 8 exactly once. Try again.")
                continue
                
            return tokens
        except ValueError:
            print("Error: Invalid numeric formatting detected. Ensure you only type numbers. Try again.")

def is_solvable(start, goal):
    """Determines grid solvability using inversion count parity."""
    def count_inversions(state):
        inversions = 0
        # Flatten and filter out the blank tile (0)
        flat_list = [tile for tile in state if tile != 0]
        for i in range(len(flat_list)):
            for j in range(i + 1, len(flat_list)):
                if flat_list[i] > flat_list[j]:
                    inversions += 1
        return inversions

    return (count_inversions(start) % 2) == (count_inversions(goal) % 2)

# --- CLI Flow Execution ---
if __name__ == "__main__":
    print("==============================================")
    print("        8-PUZZLE A* SEARCH CLI SOLVER        ")
    print("==============================================")
    
    initial_state = get_cli_input("Initial")
    goal_state = get_cli_input("Goal")
    
    print("\nValidating board state settings...")
    print("\n[Initial State Grid]:")
    print_grid(initial_state)
    print("[Goal State Grid]:")
    print_grid(goal_state)

    # Pre-computation check to avoid running infinite loops on mathematically impossible inputs
    if not is_solvable(initial_state, goal_state):
        print("❌ Error: This combination is mathematically UNSOLVABLE due to inversion parity conflicts.")
        sys.exit(1)

    print("🔄 Processing optimization paths via A* Algorithm...")
    solver = PuzzleSolver(initial_state, goal_state)
    solution_path = solver.solve()

    if solution_path:
        # Subtracting 1 since the path array includes the root starting layout
        total_moves = len(solution_path) - 1
        print(f"🟢 Solution optimized! Solved in {total_moves} moves.\n")
        
        input("Press Enter to step through the sequence of states sequentially...")
        
        for step, (state, move) in enumerate(solution_path):
            if step == 0:
                print("\n[Start State Configuration]")
            else:
                print(f"\n[Step {step}] Move Applied: {move}")
            print_grid(state)
    else:
        print("❌ No solution found.")
